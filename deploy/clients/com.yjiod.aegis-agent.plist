<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.yjiod.aegis-agent</string>
  <key>ProgramArguments</key><array><string>/Library/Application Support/AegisAgent/run-aegis-macos.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Library/Logs/AegisAgent.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/AegisAgent.error.log</string>
</dict></plist>
