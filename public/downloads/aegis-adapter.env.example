# Copy to /etc/aegis/adapter.env, set owner root:aegis and mode 0640.
# Populate only the variables referenced by /etc/aegis/adapters.json.
<EDR_VENDOR_UPPER>_EDR_TOKEN=
<MDM_VENDOR_UPPER>_TOKEN=
AEGIS_WEBHOOK_SECRET=
AEGIS_ADAPTER_POLL_SECONDS=10
AEGIS_ADAPTER_BATCH_SIZE=50
AEGIS_ADAPTER_DISPATCH_RETENTION_DAYS=90
AEGIS_ADAPTER_SPOOL_MAX_EVENTS=500
