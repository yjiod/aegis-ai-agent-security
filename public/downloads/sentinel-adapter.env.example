# Copy to /etc/sentinel/adapter.env, set owner root:sentinel and mode 0640.
# Populate only the variables referenced by /etc/sentinel/adapters.json.
<EDR_VENDOR_UPPER>_EDR_TOKEN=
<MDM_VENDOR_UPPER>_TOKEN=
SENTINEL_WEBHOOK_SECRET=
SENTINEL_ADAPTER_POLL_SECONDS=10
SENTINEL_ADAPTER_BATCH_SIZE=50
SENTINEL_ADAPTER_DISPATCH_RETENTION_DAYS=90
SENTINEL_ADAPTER_SPOOL_MAX_EVENTS=500
