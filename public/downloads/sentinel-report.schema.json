{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.internal/schemas/report-v1.json",
  "title": "Sentinel endpoint report",
  "type": "object",
  "required": ["schema", "agent_version", "policy_version", "device_id", "scanned_at", "summary", "findings"],
  "properties": {
    "schema": {"const": "sentinel.report/v1"},
    "agent_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "device_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "scanned_at": {"type": "integer"},
    "scan_root": {"type": "string", "maxLength": 1024},
    "inventory": {"type": "array", "maxItems": 5000, "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "required": ["critical", "high", "medium", "low"],
      "additionalProperties": false,
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["kind", "severity", "path", "message"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 128},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "path": {"type": "string", "maxLength": 2048},
          "message": {"type": "string", "minLength": 1, "maxLength": 2048},
          "evidence": {"type": "string", "maxLength": 512}
        }
      }
    }
  },
  "additionalProperties": false
}
