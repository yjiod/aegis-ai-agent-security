# Copy to /etc/sentinel/collector.env, set owner root:sentinel and mode 0640.
# Generate independent random values of at least 32 characters. Empty values make
# the collector fail closed at startup. Never commit the populated file.
SENTINEL_COLLECTOR_TOKEN=
SENTINEL_REPORT_SIGNING_SECRET=
# Independent bearer credential used only by the enterprise 4A / terminal-platform
# approval receipt callback. When empty, the callback endpoint fails closed (401).
SENTINEL_APPROVAL_CALLBACK_TOKEN=
# Optional final rollout gate. Populate a root:sentinel 0640 copy of the example,
# then set this path only after Collector 0.12+ and Agent 0.31 are fleet-wide.
SENTINEL_DEVICE_CREDENTIALS_FILE=
SENTINEL_ALLOW_UNSIGNED_REPORTS=false
SENTINEL_RETENTION_DAYS=30
SENTINEL_AUDIT_RETENTION_DAYS=90
SENTINEL_AUDIT_MAX_EVENTS=100000
SENTINEL_REQUESTS_PER_MINUTE=120
SENTINEL_REQUIRED_AGENT_VERSION=0.44.0
SENTINEL_REQUIRED_POLICY_VERSION=5.1.0
SENTINEL_POLICY_FILE=/opt/sentinel/sentinel-policy.json
