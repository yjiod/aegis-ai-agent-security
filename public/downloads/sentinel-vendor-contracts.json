{
  "schema": "sentinel.vendor-contracts/v1",
  "adapter_version": "0.13",
  "production_enablement": {
    "evidence_schema": "sentinel.vendor-acceptance/v1",
    "maximum_evidence_age_seconds": 604800,
    "required_for": ["sangfor", "leagsoft"],
    "secrets_allowed": false
  },
  "transport": {
    "method": "POST",
    "scheme": "https",
    "content_type": "application/json",
    "timeout_seconds": 15,
    "success_status": "200-299",
    "idempotency_header": "Idempotency-Key",
    "idempotency_value": "sha256(canonical_request_body)",
    "maximum_payload_bytes": 2000000,
    "credentials_in_url_allowed": false
  },
  "delivery_queue": {
    "overflow_behavior": "retain_source_report_and_retry",
    "silent_eviction_allowed": false,
    "credentials_stored": false,
    "write_semantics": "private_fsync_atomic_replace_directory_fsync",
    "symlink_directory_allowed": false,
    "maximum_queue_file_bytes": 2100000
  },
  "credential_boundaries": {
    "sangfor": {"header": "Authorization: Bearer <SANGFOR_* env>", "allowed_env_prefix": "SANGFOR_"},
    "leagsoft": {"header": "Authorization: Bearer <LEAGSOFT_* env>", "allowed_env_prefix": "LEAGSOFT_"},
    "security_webhook": {"headers": ["X-Sentinel-Timestamp", "X-Sentinel-Signature"], "allowed_env_prefix": "SENTINEL_", "signature_input": "<timestamp>.<raw-body>"}
  },
  "sangfor": {
    "additional_properties": false,
    "required": ["event_type", "source", "device_id", "severity", "recommended_action", "finding_count", "policy_version", "occurred_at"],
    "constants": {"event_type": "ai_agent_security_finding", "source": "sentinel"},
    "severity": ["critical", "high", "medium", "low", "normal"],
    "safe_actions": ["observe", "alert", "isolate_pending_approval", "block_pending_approval"],
    "direct_destructive_actions_allowed": false
  },
  "leagsoft": {
    "additional_properties": false,
    "required": ["source", "device_id", "compliant", "risk_level", "policy_version", "last_scan", "reason"],
    "constants": {"source": "sentinel"},
    "risk_level": ["critical", "high", "medium", "low", "normal"],
    "compliant_when": "risk_level not in [critical, high] and last_scan is within max_policy_age_hours and no more than 300 seconds in the future",
    "reason": ["policy_pass", "critical_or_high_finding", "stale_policy"],
    "future_clock_tolerance_seconds": 300,
    "compliance_configuration": {"max_policy_age_hours_min": 1, "max_policy_age_hours_max": 168, "critical_allowed": 0}
  },
  "security_webhook": {"payload_ref": "sentinel-report.schema.json"},
  "secrets_embedded": false
}
