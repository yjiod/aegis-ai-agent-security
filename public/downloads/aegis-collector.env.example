# Copy to /etc/aegis/collector.env, set owner root:aegis and mode 0640.
# Generate independent random values of at least 32 characters. Empty values make
# the collector fail closed at startup. Never commit the populated file.
AEGIS_COLLECTOR_TOKEN=
AEGIS_REPORT_SIGNING_SECRET=
# Optional final rollout gate. Populate a root:aegis 0640 copy of the example,
# then set this path only after Collector 0.12 and Agent 0.30 are fleet-wide.
AEGIS_DEVICE_CREDENTIALS_FILE=
AEGIS_ALLOW_UNSIGNED_REPORTS=false
AEGIS_RETENTION_DAYS=30
AEGIS_AUDIT_RETENTION_DAYS=90
AEGIS_AUDIT_MAX_EVENTS=100000
AEGIS_REQUESTS_PER_MINUTE=120
AEGIS_REQUIRED_AGENT_VERSION=0.30.0
AEGIS_REQUIRED_POLICY_VERSION=4.8.0
